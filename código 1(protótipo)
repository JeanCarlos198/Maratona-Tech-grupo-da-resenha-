<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#06071a; --card:#141840; --card2:#1a1f52; --line:rgba(255,255,255,.09);
  --txt:#eef0ff; --mut:#9aa0c7;
  --blue:#5aa9ff; --purple:#8b5cf6; --cyan:#3fd0d2;
  --red:#ff5468; --amber:#ffb020; --green:#2ee59d;
  --grad:linear-gradient(135deg,#5aa9ff,#8b5cf6 55%,#c44dff);
}
html,body{height:100%}
body{background:var(--bg);color:var(--txt);font-family:'Sora',system-ui,sans-serif;overflow:hidden}
/* ===== fundo vivo ===== */
.bgfx{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.bgfx .grid{position:absolute;inset:0;background-image:linear-gradient(rgba(90,169,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(90,169,255,.06) 1px,transparent 1px);background-size:46px 46px;-webkit-mask-image:radial-gradient(ellipse at 50% 42%,#000 25%,transparent 75%);mask-image:radial-gradient(ellipse at 50% 42%,#000 25%,transparent 75%)}
.blob{position:absolute;border-radius:50%;filter:blur(75px);opacity:.32;animation:drift 16s ease-in-out infinite alternate}
.b1{width:440px;height:440px;background:#3b2a8f;top:-140px;left:-90px}
.b2{width:400px;height:400px;background:#0d4f70;bottom:-140px;right:-70px;animation-delay:-8s}
@keyframes drift{to{transform:translate(70px,45px) scale(1.12)}}
.bit{position:absolute;font-family:'Unbounded';font-size:11px;color:rgba(140,150,255,.28);animation:fall linear infinite;top:-40px}
@keyframes fall{to{transform:translateY(112vh)}}
/* ===== palco ===== */
.stage{position:relative;z-index:1;height:100dvh;display:flex;align-items:center;justify-content:center;gap:60px;padding:18px}
.side{width:330px;flex:none}
.side .kicker{font-family:'Unbounded';font-size:11px;letter-spacing:3px;color:var(--cyan);text-transform:uppercase}
.side h2{font-family:'Unbounded';font-size:34px;line-height:1.1;margin:14px 0 8px}
.side h2 span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.side .tag{color:var(--mut);font-size:14px;line-height:1.6;margin-bottom:20px}
.side ul{list-style:none;display:grid;gap:10px;margin-bottom:22px}
.side li{font-size:13px;color:#cfd4f7;display:flex;gap:10px;align-items:center;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:12px;padding:9px 12px;transition:.25s}
.side li:hover{border-color:var(--purple);transform:translateX(4px)}
.side .stamp{font-size:11px;color:var(--mut);border-top:1px dashed var(--line);padding-top:14px}
/* ===== telefone ===== */
.phone{width:398px;height:min(850px,96dvh);flex:none;background:#04050f;border-radius:46px;border:1px solid #2a2f6b;padding:11px;position:relative;box-shadow:0 40px 90px rgba(20,10,80,.55),0 0 0 1px rgba(139,92,246,.15),inset 0 0 30px rgba(90,169,255,.05)}
.phone::before{content:'';position:absolute;top:20px;left:50%;transform:translateX(-50%);width:120px;height:24px;background:#04050f;border-radius:14px;z-index:30;border:1px solid #1c2150}
.app{height:100%;display:flex;flex-direction:column;background:radial-gradient(120% 90% at 50% -5%,#181d52 0%,#0a0c26 55%,#070818 100%);border-radius:36px;overflow:hidden;position:relative}
.app::after{content:'';position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(255,255,255,.012) 3px 4px);z-index:1}
/* barra superior */
.appbar{display:flex;align-items:center;gap:10px;padding:38px 14px 10px;position:relative;z-index:5}
.iconbtn{width:36px;height:36px;flex:none;border-radius:11px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--txt);font-size:15px;cursor:pointer;transition:.2s;display:grid;place-items:center}
.iconbtn:hover{border-color:var(--blue);transform:translateY(-1px)}
#hBack{visibility:hidden}
.hTitle{flex:1;text-align:center;font-family:'Unbounded';font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:#dfe3ff}
/* telas */
.screens{flex:1;overflow-y:auto;position:relative;z-index:4;scrollbar-width:thin;scrollbar-color:#3a3f8a transparent}
.screens::-webkit-scrollbar{width:5px}.screens::-webkit-scrollbar-thumb{background:#3a3f8a;border-radius:4px}
.screen{display:none;padding:10px 16px 26px}
.screen.active{display:block}
.screen.active>*{animation:rise .55s cubic-bezier(.2,.7,.2,1) both}
.screen.active>*:nth-child(2){animation-delay:.06s}.screen.active>*:nth-child(3){animation-delay:.12s}
.screen.active>*:nth-child(4){animation-delay:.18s}.screen.active>*:nth-child(5){animation-delay:.24s}
.screen.active>*:nth-child(6){animation-delay:.3s}.screen.active>*:nth-child(7){animation-delay:.36s}
@keyframes rise{from{opacity:0;transform:translateY(14px)}}
.rv{opacity:0;transform:translateY(14px);transition:opacity .5s,transform .5s}
.rv.vis{opacity:1;transform:none}
/* componentes gerais */
h3.sec{font-family:'Unbounded';font-size:16px;line-height:1.3;margin:20px 0 10px}
h3.sec em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
p.lead{color:var(--mut);font-size:13px;line-height:1.65}
.card{background:linear-gradient(180deg,var(--card),#101336);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px;transition:.25s}
.card:hover{border-color:rgba(139,92,246,.55);transform:translateY(-2px)}
.badge{display:inline-flex;align-items:center;gap:5px;font-size:9.5px;font-weight:700;letter-spacing:.4px;padding:3px 8px;border-radius:99px;border:1px solid;text-transform:uppercase}
.bg-green{color:var(--green);border-color:rgba(46,229,157,.4);background:rgba(46,229,157,.08)}
.bg-red{color:#ff8a97;border-color:rgba(255,84,104,.45);background:rgba(255,84,104,.1)}
.bg-amber{color:#ffcf70;border-color:rgba(255,176,32,.45);background:rgba(255,176,32,.1)}
.bg-blue{color:#8cc4ff;border-color:rgba(90,169,255,.45);background:rgba(90,169,255,.1)}
.btn{font-family:'Sora';font-weight:700;font-size:14px;border:none;cursor:pointer;border-radius:14px;padding:14px 20px;color:#fff;background:var(--grad);box-shadow:0 8px 24px rgba(139,92,246,.35);transition:.2s;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}
.btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(139,92,246,.5)}
.btn:active{transform:scale(.97)}
.btn.ghost{background:rgba(255,255,255,.06);box-shadow:none;border:1px solid var(--line)}
.btn.ghost:hover{border-color:var(--blue)}
.btn.wide{width:100%}
.btn.real{background:linear-gradient(135deg,#1db77e,#2ee59d);color:#04281a;box-shadow:0 8px 20px rgba(46,229,157,.25)}
.btn.fakeb{background:linear-gradient(135deg,#e0334c,#ff5468);box-shadow:0 8px 20px rgba(255,84,104,.25)}
.btn.real:hover,.btn.fakeb:hover{transform:translateY(-2px)}
.mini{font-size:11px;color:var(--mut);line-height:1.6}
/* ===== TELA 1 — abertura ===== */
.home{display:flex;flex-direction:column;justify-content:center;min-height:100%;text-align:center;padding-top:26px}
.evchip{display:inline-flex;gap:6px;align-items:center;align-self:center;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#cfd4f7;border:1px solid var(--line);border-radius:99px;padding:6px 13px;background:rgba(255,255,255,.04);margin-bottom:26px}
.logo{width:96px;height:96px;margin:0 auto 18px;border-radius:28px;background:var(--grad);display:grid;place-items:center;font-size:46px;box-shadow:0 16px 44px rgba(139,92,246,.5);animation:floaty 4.5s ease-in-out infinite}
@keyframes floaty{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-9px) rotate(2deg)}}
.wordmark{font-family:'Unbounded';font-weight:900;font-size:31px;letter-spacing:2px;position:relative;display:inline-block}
.wordmark::before,.wordmark::after{content:attr(data-t);position:absolute;inset:0;opacity:.75}
.wordmark::before{color:var(--cyan);animation:gl1 3.2s infinite steps(1)}
.wordmark::after{color:var(--red);animation:gl2 2.9s infinite steps(1)}
@keyframes gl1{0%,93%,100%{transform:none;opacity:0}94%{transform:translate(-3px,1px);opacity:.8}97%{transform:translate(2px,-1px);opacity:.6}}
@keyframes gl2{0%,88%,100%{transform:none;opacity:0}89%{transform:translate(3px,-2px);opacity:.8}92%{transform:translate(-2px,1px);opacity:.6}}
.tw{font-size:15px;color:#cfd4f7;margin:14px 0 4px;min-height:24px}
.tw .caret{display:inline-block;width:8px;background:var(--cyan);animation:blink .8s steps(1) infinite;margin-left:2px}
@keyframes blink{50%{opacity:0}}
.homestats{display:flex;gap:8px;justify-content:center;margin:22px 0 24px;flex-wrap:wrap}
.homestats span{font-size:10.5px;padding:7px 11px;border-radius:11px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--mut)}
.homestats b{color:#fff}
.homebtns{display:grid;gap:10px}
.shine{position:relative;overflow:hidden}
.shine::after{content:'';position:absolute;top:0;left:-80%;width:50%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-20deg);animation:sweep 2.8s ease-in-out infinite}
@keyframes sweep{0%,55%{left:-80%}90%,100%{left:130%}}
/* ===== TELA 2 — problema ===== */
.def{border-left:3px solid var(--purple);position:relative}
.def .scan{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);animation:scan 3.4s linear infinite;opacity:.7}
@keyframes scan{from{top:6%}to{top:94%}}
.vs{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.vs .card{margin:0}
.vs h4{font-family:'Unbounded';font-size:11.5px;margin-bottom:7px}
.vs p{font-size:11.5px;color:var(--mut);line-height:1.55}
.cases .card{display:flex;gap:12px;align-items:flex-start}
.cico{font-size:24px;flex:none;width:44px;height:44px;display:grid;place-items:center;border-radius:13px;background:rgba(255,255,255,.05);border:1px solid var(--line)}
.cases h4{font-size:13.5px;margin-bottom:4px}
.cases p{font-size:11.5px;color:var(--mut);line-height:1.55;margin-bottom:7px}
/* comparador */
.cmp{position:relative;border-radius:18px;overflow:hidden;border:1px solid var(--line);aspect-ratio:10/9;user-select:none;touch-action:none;cursor:ew-resize;--x:56%}
.cmp-layer{position:absolute;inset:0}
.cmp-layer svg{width:100%;height:100%;display:block}
.cmp-fake{clip-path:inset(0 0 0 var(--x))}
.cmp-handle{position:absolute;top:0;bottom:0;left:var(--x);width:3px;background:#fff;transform:translateX(-50%);box-shadow:0 0 14px rgba(255,255,255,.8);z-index:3}
.cmp-handle::after{content:'⟷';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;font-size:16px;box-shadow:0 4px 14px rgba(0,0,0,.5)}
.cmp-tag{position:absolute;top:10px;font-family:'Unbounded';font-size:9px;letter-spacing:1.5px;padding:5px 9px;border-radius:8px;z-index:2}
.cmp-tag.o{left:10px;background:rgba(46,229,157,.9);color:#04281a}
.cmp-tag.f{right:10px;background:rgba(255,84,104,.92);color:#fff}
.legend{display:grid;gap:6px;margin-top:10px}
.legend div{font-size:11px;color:var(--mut);display:flex;gap:8px;align-items:center}
.dotn{width:18px;height:18px;flex:none;border-radius:50%;background:var(--red);color:#fff;font-size:10px;font-weight:700;display:grid;place-items:center}
/* ===== TELA 3 — fluxo ===== */
.flow{position:relative;padding-left:6px}
.step{display:flex;gap:12px;position:relative}
.snum{flex:none;width:46px;height:46px;border-radius:14px;display:grid;place-items:center;font-size:20px;background:var(--grad);box-shadow:0 6px 18px rgba(139,92,246,.35)}
.scard{flex:1;background:linear-gradient(180deg,var(--card),#101336);border:1px solid var(--line);border-radius:15px;padding:12px 14px;margin-bottom:4px;transition:.25s}
.scard:hover{border-color:var(--cyan);transform:translateX(4px)}
.scard b{font-family:'Unbounded';font-size:11px;letter-spacing:1px;display:block;margin-bottom:4px;color:#dfe3ff}
.scard p{font-size:11.5px;color:var(--mut);line-height:1.55}
.farrow{height:34px;width:46px;display:grid;place-items:center;color:var(--purple);font-size:20px;animation:pulseA 1.6s ease-in-out infinite}
@keyframes pulseA{0%,100%{transform:translateY(0);opacity:.6}50%{transform:translateY(6px);opacity:1}}
.alertline{border:1px dashed rgba(255,176,32,.55);background:rgba(255,176,32,.07);border-radius:14px;padding:11px 13px;font-size:11.5px;color:#ffcf70;line-height:1.55;margin-top:8px}
/* ===== TELA 4 — riscos ===== */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.who{margin:0}
.who .e{font-size:24px}
.who b{font-size:12px;display:block;margin:6px 0 3px}
.who p{font-size:10.5px;color:var(--mut);line-height:1.5}
.who.w-red{border-left:3px solid var(--red)}
.who.w-amber{border-left:3px solid var(--amber)}
.who.w-blue{border-left:3px solid var(--blue)}
.who.w-purple{border-left:3px solid var(--purple)}
.consq{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px dashed var(--line);font-size:12px;line-height:1.55;color:#dfe3ff}
.consq:last-child{border:none}
.consq span{font-size:17px;flex:none}
.ele{border:1px solid rgba(255,176,32,.5);background:linear-gradient(180deg,rgba(255,176,32,.09),rgba(255,84,104,.06));border-radius:18px;padding:16px;margin-top:16px}
.ele h4{font-family:'Unbounded';font-size:14px;margin-bottom:4px}
.ele .sub{font-size:11px;color:#ffcf70;margin-bottom:12px}
.eitem{display:flex;gap:9px;font-size:11.5px;line-height:1.5;color:#f4e9d4;margin-bottom:9px}
.eitem b{color:#fff}
/* ===== TELA 5 — defesa ===== */
.list{display:grid;gap:8px}
.item{display:flex;gap:11px;align-items:flex-start;background:rgba(255,255,255,.035);border:1px solid var(--line);border-radius:13px;padding:11px 12px;font-size:12px;line-height:1.55;transition:.2s}
.item:hover{transform:translateX(3px)}
.item .ic{font-size:18px;flex:none;margin-top:1px}
.item.g{border-left:3px solid var(--green)}
.item.r{border-left:3px solid var(--red)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.chip{font-size:11px;font-weight:600;border-radius:99px;padding:8px 13px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:#dfe3ff;cursor:pointer;transition:.2s}
.chip:hover{border-color:var(--cyan);transform:translateY(-2px)}
/* ===== quiz ===== */
.qtop{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.qtop span{font-family:'Unbounded';font-size:10.5px;letter-spacing:1px;color:var(--mut)}
.qbar{flex:1;height:7px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}
.qbar i{display:block;height:100%;width:0;background:var(--grad);border-radius:99px;transition:width .4s}
.qcard{background:linear-gradient(180deg,var(--card2),#131747);border:1px solid var(--line);border-radius:18px;padding:20px 16px;text-align:center;min-height:150px;display:flex;flex-direction:column;justify-content:center;gap:10px}
.qcard .qi{font-size:34px}
.qcard p{font-size:13.5px;line-height:1.6}
.qbtns{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}
.qwhy{border-radius:14px;padding:12px 14px;font-size:12px;line-height:1.6;margin-bottom:12px}
.qwhy.ok{background:rgba(46,229,157,.12);border:1px solid rgba(46,229,157,.5);color:#c9ffe8}
.qwhy.err{background:rgba(255,84,104,.12);border:1px solid rgba(255,84,104,.5);color:#ffd7dc}
.shake{animation:shake .4s}
@keyframes shake{20%{transform:translateX(-6px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}
.endcard{text-align:center;padding:26px 18px}
.endcard .big{font-family:'Unbounded';font-size:42px;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.endcard h4{font-family:'Unbounded';font-size:15px;margin:10px 0 8px}
/* ===== simulador ===== */
.chat{display:flex;flex-direction:column;gap:9px;min-height:200px;max-height:320px;overflow-y:auto;padding:4px 2px;margin-bottom:10px}
.bub{max-width:86%;padding:10px 13px;border-radius:15px;font-size:12px;line-height:1.6;animation:rise .4s both}
.bub.bot{background:rgba(255,255,255,.06);border:1px solid var(--line);border-bottom-left-radius:4px;align-self:flex-start}
.bub.user{background:linear-gradient(135deg,#3b6fe0,#8b5cf6);border-bottom-right-radius:4px;align-self:flex-end}
.bub .lvl{display:inline-block;font-size:9.5px;font-weight:700;letter-spacing:.6px;padding:3px 8px;border-radius:99px;margin-bottom:6px}
.chatinput{display:flex;gap:8px;margin-top:10px}
.chatinput input{flex:1;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:12px;color:#fff;font-family:'Sora';font-size:12.5px;padding:12px;outline:none}
.chatinput input:focus{border-color:var(--blue)}
.chatinput button{flex:none}
/* ===== fontes ===== */
.src .card h4{font-size:12.5px;margin-bottom:4px}
.src .card p{font-size:11px;color:var(--mut);line-height:1.55}
.rulebox{border:1px solid rgba(255,176,32,.5);background:rgba(255,176,32,.07);border-radius:15px;padding:13px;font-size:11.5px;line-height:1.6;color:#ffe9c4;margin-top:6px}
/* ===== tabbar ===== */
.tabbar{display:flex;gap:4px;padding:9px 10px 14px;border-top:1px solid var(--line);background:rgba(6,7,26,.85);backdrop-filter:blur(8px);position:relative;z-index:6}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:7px 2px;border-radius:13px;background:none;border:none;color:var(--mut);font-family:'Sora';font-size:9px;font-weight:600;cursor:pointer;transition:.2s}
.tab .ti{font-size:18px;transition:.2s}
.tab:hover{color:#dfe3ff}
.tab.on{color:#fff;background:rgba(139,92,246,.16)}
.tab.on .ti{transform:translateY(-2px) scale(1.15);filter:drop-shadow(0 3px 8px rgba(139,92,246,.6))}
@media(max-width:920px){.side{display:none}.stage{padding:0}}
@media(max-width:440px){.phone{width:100%;height:100dvh;border-radius:0;border:none;padding:0}.phone::before{display:none}.app{border-radius:0}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
