              • Imagens sintéticas não consensuais da cantora Taylor Swift (2024) — repercussão global e debate legislativo.<br>
              • Videochamada falsa em Hong Kong (2024) — cobertura internacional (ex.: CNN).<br>
              • Golpes com voz clonado no Brasil — imprensa brasileira.</p></div>
          </div>
          <div class="rulebox rv">⚠️ <b>Regra do projeto:</b> nenhum dado foi inventado. Quando a confirmação exata não foi possível, usamos linguagem genérica (“cerca de”, “segundo a imprensa”). Este protótipo é educativo — para detalhes, consulte as fontes originais.</div>
          <p class="mini" style="margin-top:14px;text-align:center">Protótipo educativo · Maratona Tech 2026 · Fase 1: Dilemas Digitais<br>Equipe: ______________________</p>
        </section>

      </main>

      <!-- barra inferior -->
      <nav class="tabbar">
        <button class="tab on" data-t="home"><span class="ti">🏠</span>Início</button>
        <button class="tab" data-t="problema"><span class="ti">🧐</span>Problema</button>
        <button class="tab" data-t="como"><span class="ti">⚙️</span>Como</button>
        <button class="tab" data-t="riscos"><span class="ti">⚠️</span>Riscos</button>
        <button class="tab" data-t="defesa"><span class="ti">🛡️</span>Defesa</button>
      </nav>
    </div>
  </div>
</div>

<script>
/* ================= navegação ================= */
const $=s=>document.querySelector(s), $$=s=>document.querySelectorAll(s);
const TABS=['home','problema','como','riscos','defesa'];
const TITLES={home:'Início',problema:'O Problema',como:'Como Acontece',riscos:'Riscos',defesa:'Defesa',quiz:'Quiz Real ou Fake',sim:'Simulador',cmp:'Laboratório',fontes:'Fontes'};
let prevTab='home';
function go(id){
  if(TABS.includes(id)) prevTab=id;
  $$('.screen').forEach(s=>s.classList.toggle('active', s.id==='s-'+id));
  $('#screens').scrollTop=0;
  $('#hTitle').textContent=TITLES[id];
  $('#hBack').style.visibility=(TABS.includes(id)&&id!=='home')?'hidden':'visible';
  $$('.tab').forEach(b=>b.classList.toggle('on',b.dataset.t===(TABS.includes(id)?id:prevTab)));
  if(id==='home') typeTag();
}
$$('.tab').forEach(b=>b.addEventListener('click',()=>go(b.dataset.t)));
$('#hBack').addEventListener('click',()=>go(prevTab));
$('#hSrc').addEventListener('click',()=>go('fontes'));
document.addEventListener('keydown',e=>{
  if(/INPUT|TEXTAREA/.test(document.activeElement.tagName))return;
  const i=TABS.indexOf(prevTab);
  if(e.key==='ArrowRight'&&i<TABS.length-1)go(TABS[i+1]);
  if(e.key==='ArrowLeft'&&i>0)go(TABS[i-1]);
});
/* revelação ao rolar */
const io=new IntersectionObserver(es=>es.forEach(x=>x.isIntersecting&&x.target.classList.add('vis')),{root:$('#screens'),threshold:.15});
$$('.rv').forEach(el=>io.observe(el));
/* ================= abertura: typewriter ================= */
let twTimer=null;
function typeTag(){
  const el=$('#tw'), txt='Nem tudo que você vê é real.';
  clearInterval(twTimer); el.textContent=''; let i=0;
  twTimer=setInterval(()=>{el.textContent=txt.slice(0,++i); if(i>=txt.length)clearInterval(twTimer);},42);
}
typeTag();
/* ================= comparador (slider) ================= */
function initCmp(el){
  if(!el)return;
  const set=x=>{x=Math.max(8,Math.min(92,x)); el.style.setProperty('--x',x+'%'); el._x=x;};
  el._x=56; set(56);
  const move=e=>{const r=el.getBoundingClientRect(); set((e.clientX-r.left)/r.width*100);};
  el.addEventListener('pointerdown',e=>{el.setPointerCapture(e.pointerId); move(e);
    const mv=ev=>move(ev), up=()=>{el.removeEventListener('pointermove',mv);el.removeEventListener('pointerup',up);};
    el.addEventListener('pointermove',mv); el.addEventListener('pointerup',up);});
  el.addEventListener('keydown',e=>{
    if(e.key==='ArrowLeft'){set(el._x-4);e.preventDefault();}
    if(e.key==='ArrowRight'){set(el._x+4);e.preventDefault();}
  });
}
initCmp($('#cmp'));
/* duplica o comparador na tela própria */
const cmpA=$('#cmp'); if(cmpA){const c2=$('#cmp2'); c2.innerHTML=cmpA.innerHTML; initCmp(c2);}
/* ================= quiz ================= */
const QUIZ=[
 {i:'🎭',t:'Vídeo viral: um político anuncia uma medida absurda. A boca não acompanha o áudio e a voz parece metálica.',a:'fake',w:'Boca fora de sincronia + voz robótica são sinais clássicos de deepfake. Antes de compartilhar, procure a informação em fontes oficiais.'},
 {i:'🏛️',t:'Nota publicada no site oficial do TSE (tse.jus.br) explicando as regras das eleições.',a:'real',w:'Sites oficiais do governo (final .jus.br) são fontes primárias confiáveis para informação eleitoral.'},
 {i:'📲',t:'Áudio no WhatsApp: seu “primo” pede um Pix urgente, mas a voz está meio estranha e cortada.',a:'fake',w:'Padrão clássico de golpe: voz clonada + urgência + pedido de dinheiro. Ligue você mesmo para a pessoa antes de qualquer Pix.'},
 {i:'🗳️',t:'Vídeo afirma que urnas foram fraudadas, mas nenhuma agência de checagem nem veículo confiável confirmou.',a:'fake',w:'Sem confirmação de fonte confiável, trate como falso. O TSE e agências como Lupa, Aos Fatos e Comprova checam esse tipo de boato com frequência.'},
 {i:'📺',t:'Live no canal verificado de uma grande emissora: imagem nítida, rosto consistente e sem falhas.',a:'real',w:'Canal oficial + imagem consistente = maior confiabilidade. Ainda assim, para decisões importantes, confirme em mais de uma fonte.'}
];
let qi=0,qScore=0,locked=false;
function quizStart(){qi=0;qScore=0;$('#quizEnd').hidden=true;$('#quizBox').hidden=false;locked=false;renderQ();}
function renderQ(){
  const q=QUIZ[qi]; locked=false;
  $('#qCount').textContent=`CASO ${qi+1}/${QUIZ.length}`;
  $('#qFill').style.width=(qi/QUIZ.length*100)+'%';
  $('#qCard').innerHTML=`<div class="qi">${q.i}</div><p>${q.t}</p>`;
  $('#qWhy').hidden=true; $('#qNext').hidden=true;
  $('#btnReal').disabled=false; $('#btnFake').disabled=false;
}
function answer(v){
  if(locked)return; locked=true;
  const q=QUIZ[qi], ok=(v===q.a), why=$('#qWhy');
  if(ok)qScore++;
  why.hidden=false; why.className='qwhy '+(ok?'ok':'err');
  why.innerHTML=(ok?'✅ Boa! ':'🚨 Cuidado! ')+q.w;
  $('#btnReal').disabled=true; $('#btnFake').disabled=true;
  if(!ok)$('#qCard').classList.add('shake');
  setTimeout(()=>$('#qCard').classList.remove('shake'),450);
  $('#qFill').style.width=((qi+1)/QUIZ.length*100)+'%';
  const nx=$('#qNext'); nx.hidden=false;
  nx.textContent=(qi<QUIZ.length-1)?'Próximo caso →':'Ver resultado 🏁';
}
$('#btnReal').addEventListener('click',()=>answer('real'));
$('#btnFake').addEventListener('click',()=>answer('fake'));
$('#qNext').addEventListener('click',()=>{
  if(qi<QUIZ.length-1){qi++;renderQ();}
  else{
    $('#quizBox').hidden=true; $('#quizEnd').hidden=false;
    $('#endScore').textContent=qScore+'/'+QUIZ.length;
    let e,r,m;
    if(qScore===5){e='🕵️';r='Detetive Anti-Deepfake!';m='Olho treinado: você pegou todos os sinais. Agora ensine sua rede a fazer o mesmo.';}
    else if(qScore>=3){e='👍';r='No caminho certo!';m='Você já percebe vários sinais. Revise o comparador e a tela de prevenção para ficar expert.';}
    else{e='🚨';r='Hora de treinar o olhar!';m='Sem pânico: volte nas telas “O Problema” e “Defesa” e refaça o quiz. Em minutos você desmascara qualquer fake.';}
    $('#endEmoji').textContent=e;$('#endRank').textContent=r;$('#endMsg').textContent=m;
  }
});
quizStart();
/* ================= simulador ================= */
const RULES=[
 {k:['nude','íntim','intim','chantag','sextors','vazou'],lvl:'RISCO GRAVE',c:'#ff5468',r:'Isso é sério. Não compartilhe nada, salve as provas (prints, links) e denuncie: <b>SaferNet (denuncie.org.br)</b> + <b>Boletim de Ocorrência</b>. Se envolver eleição ou candidato, avise também a Justiça Eleitoral.'},
 {k:['urna','eleiç','eleic','voto','candidat','tse','partido','polític','politic'],lvl:'CHECAGEM ELEITORAL',c:'#ffb020',r:'Conteúdo político viral merece verificação antes do compartilhamento. Procure a informação no site do <b>TSE</b> e nas agências <b>Lupa, Aos Fatos e Comprova</b>. Se for falso, denuncie no app <b>Pardal</b> e na própria plataforma.'},
 {k:['chefe','empresa','diretor','videochamada','reunião','contrato'],lvl:'ALTO RISCO',c:'#ff5468',r:'Golpe corporativo clássico — já houve casos reais de videochamadas 100% falsas geradas por IA. <b>Confirme por outro canal oficial</b> (telefone conhecido, e-mail corporativo) antes de qualquer transferência e avise o setor de segurança da empresa.'},
 {k:['pix','dinheiro','transfer','pagar','urgente','empréstimo','empresta'],lvl:'ALTO RISCO',c:'#ff5468',r:'Urgência + pedido de dinheiro = sinal vermelho. Vozes podem ser clonadas em segundos. <b>Ligue você mesmo</b> para a pessoa pelo número que você já conhece. Nunca transfira antes de confirmar.'},
 {k:['voz','áudio','audio','robót','metálic','cortad','estranh','sincronia','piscar'],lvl:'SINAIS DE DEEPFAKE',c:'#ffb020',r:'Voz cortada/robótica e falhas no rosto são indícios de falsificação por IA. Não compartilhe: faça busca reversa, cheque agências de fact-checking e denuncie o conteúdo na plataforma.'},
 {k:['sorteio','prêmio','premio','ganhei','herança','cripto','investimento'],lvl:'PROVÁVEL GOLPE',c:'#ffb020',r:'Promessa fácil demais costuma ser isca. Verifique o perfil oficial (selo, seguidores, histórico) e nunca informe dados ou códigos de verificação.'}
];
const DEFAULT_R={lvl:'DESCONFIE POR PRINCÍPIO',c:'#5aa9ff',r:'Não consegui identificar um padrão específico, mas a regra de ouro vale: <b>confirme por outro canal</b>, procure em fontes oficiais e de checagem (Lupa, Aos Fatos, Comprova, TSE) e não compartilhe antes de ter certeza. 👀'};
function botSay(html){
  const c=$('#chat'), b=document.createElement('div');
  b.className='bub bot'; b.innerHTML=html; c.appendChild(b); c.scrollTop=c.scrollHeight;
}
function userSay(t){
  const c=$('#chat'), b=document.createElement('div');
  b.className='bub user'; b.textContent=t; c.appendChild(b); c.scrollTop=c.scrollHeight;
}
function analyze(t){
  const s=t.toLowerCase();
  const hit=RULES.find(r=>r.k.some(k=>s.includes(k)))||DEFAULT_R;
  botSay(`<span class="lvl" style="background:${hit.c}22;color:${hit.c};border:1px solid ${hit.c}66">⚠ ${hit.lvl}</span><br>${hit.r}`);
}
function simSay(t){userSay(t);setTimeout(()=>analyze(t),350);}
$('#simGo').addEventListener('click',()=>{const i=$('#simIn');if(i.value.trim()){const v=i.value.trim();i.value='';userSay(v);setTimeout(()=>analyze(v),350);}});
$('#simIn').addEventListener('keydown',e=>{if(e.key==='Enter')$('#simGo').click();});
botSay('Oi! Eu sou o <b>DesmascaraBot</b> 🤖. Me conte uma situação suspeita (ou toque num cenário acima) que eu analiso os sinais de deepfake ou golpe.');
</script>
</body>
</html>
